#!/usr/bin/env bash

cat <<EOF > /tmp/textpattern-setup-config.json || exit 1
{
    "site": {
        "language_code": "en",
        "public_url": "${DOMAIN}",
        "admin_theme": "${ADMIN_THEME}",
        "public_theme": "${PUBLIC_THEME}",
        "content_directory": ""
    },
    "database": {
        "user": "${DATABASE_USER}",
        "password": "${DATABASE_PASSWORD}",
        "host": "${DATABASE_HOST}",
        "db_name": "${DATABASE_NAME}",
        "table_prefix": ""
    },
    "user": {
        "full_name": "${ADMIN_USER_FULL_NAME}",
        "email": "${ADMIN_USER_EMAIL}",
        "login_name": "${ADMIN_USER_LOGIN_NAME}",
        "password": "${ADMIN_USER_PASSWORD}"
    }
}
EOF

cat <<EOF > /var/www/html/public/textpattern/setup/data/custom.prefs || exit 1
{
    "file_base_path": {
        "val": "/var/www/html/files",
        "type": "0",
        "event": "admin",
        "html": "text_input",
        "position": "40"
    },
    "permlink_format": {
        "val": "1",
        "type": "0",
        "event": "publish",
        "html": "permlink_format",
        "position": "100"
    },
    "permlink_mode": {
        "val": "year_month_day_title",
        "type": "0",
        "event": "site",
        "html": "permlinkmodes",
        "position": "180"
    },
    "skin_dir": {
        "val": "../themes",
        "type": "0",
        "event": "admin",
        "html": "text_input",
        "position": "30"
    },
    "tempdir": {
        "val": "/var/www/html/tmp",
        "type": "0",
        "event": "admin",
        "html": "text_input",
        "position": "80"
    },
    "url_mode": {
        "val": "1",
        "type": "2",
        "event": "publish",
        "html": "text_input",
        "position": "0"
    }
}
EOF

textpattern-wait-for-db || exit 1

status=0

php /var/www/html/public/textpattern/setup/setup.php --config="/tmp/textpattern-setup-config.json" || status=1

rm -f /tmp/textpattern-setup-config.json || exit 1

if [ "$status" -eq 1 ]; then
    exit 1
fi

textpattern-configure || exit 1
